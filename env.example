# ============================================================
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# NEVER commit your real .env file to GitHub.
# ============================================================

# --- Required ---------------------------------------------
# Bot token from @BotFather
BOT_TOKEN=
# API credentials from https://my.telegram.org  (API development tools)
API_ID=
API_HASH=
# Your numeric Telegram user ID (get it from @userinfobot)
ADMIN_ID=

# --- Bot identity -----------------------------------------
# Your bot's username (used in referral links and message footers)
BOT_USERNAME=your_bot
# Your Telegram username, shown to banned users as a contact (optional)
ADMIN_USERNAME=
# Text added when users share their referral link (optional)
SHARE_TEXT=Telegramdagi avto xabar bot

# --- Channels & groups ------------------------------------
# Channel users must join before using the bot, e.g. @my_channel (empty = no check)
REQUIRED_CHANNEL=
# Bots that get "/start" when a user connects an account, comma separated (optional)
# Example: @first_bot,@second_bot
REQUIRED_BOTS=
# Group where payment screenshots are sent (bot must be a member/admin). Example: -1001234567890
PAYMENTS_GROUP_ID=
# Group notified about new users (0 or empty = off)
NEW_MEMBERS_GROUP_ID=
# Channel where the live statistics message is posted (0 or empty = off)
STATS_CHANNEL_ID=

# --- Payments (manual card payments) ----------------------
CARD_NUMBER=
VISA_CARD_NUMBER=

# --- Premium & limits (optional, defaults shown) ----------
PREMIUM_PRICE_STARS=40
PREMIUM_PRICE_MONEY=5000
PREMIUM_DAYS=30
PREMIUM_MIN_INTERVAL=2
NON_PREMIUM_MIN_INTERVAL=5
MAX_INTERVAL=15
PREMIUM_GROUP_LIMIT=30
NON_PREMIUM_GROUP_LIMIT=5
PREMIUM_MESSAGE_LIMIT=1000
NON_PREMIUM_MESSAGE_LIMIT=100
REFERRAL_DISCOUNT_PER_USER=250
